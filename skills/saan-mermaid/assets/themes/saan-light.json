{
  "name": "saan-light",
  "description": "Default Saan palette for light pages. Matches saan-diagram.",
  "config": {
    "theme": "base",
    "look": "classic",
    "themeVariables": {
      "fontFamily": "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, sans-serif",
      "primaryColor": "#E3E5EA",
      "primaryTextColor": "#1F2329",
      "primaryBorderColor": "#E3E5EA",
      "secondaryColor": "#E9ECF1",
      "tertiaryColor": "#F5F6F8",
      "lineColor": "#4E5563",
      "textColor": "#1F2329",
      "clusterBkg": "#F5F6F8",
      "clusterBorder": "#D5D8DE",
      "edgeLabelBackground": "#FFFFFF",
      "dropShadow": "none",
      "cScale0": "#E3E5EA",
      "cScale1": "#E2EBFF",
      "cScale2": "#E9ECF1",
      "cScale3": "#F5F6F8"
    },
    "quadrantChart": {
      "pointTextPadding": 14
    }
  },
  "roles": {
    "core": {
      "fill": "#E2EBFF",
      "stroke": "#2B5FD8",
      "color": "#1F2329"
    },
    "hub": {
      "fill": "#D0D3D9",
      "stroke": "#D0D3D9",
      "color": "#1F2329"
    },
    "system": {
      "fill": "#2B5FD8",
      "stroke": "#2B5FD8",
      "color": "#FFFFFF"
    },
    "external": {
      "fill": "#8FB0FF",
      "stroke": "#8FB0FF",
      "color": "#1F2329"
    },
    "ai": {
      "fill": "#FDEBD8",
      "stroke": "#F5C99B",
      "color": "#1F2329"
    }
  }
}
